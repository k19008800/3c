{
  "name": "3cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.5",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -w api test",
    "test:coverage": "pnpm -w api test:coverage",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm -w api db:generate",
    "db:migrate": "pnpm -w api db:migrate",
    "worker": "pnpm -w api worker"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "@eslint/js": "^9.0.0",
    "prettier": "^3.3.0",
    "@types/node": "^22.0.0"
  }
}
