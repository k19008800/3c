{
  "name": "3cloud",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:api": "pnpm --filter @3cloud/api dev",
    "dev:console": "pnpm --filter web-console dev",
    "dev:portal": "pnpm --filter web-portal dev",
    "build": "pnpm --filter @3cloud/shared build && pnpm --filter @3cloud/api build && pnpm --filter web-console build && pnpm --filter web-portal build",
    "db:create": "node api/create-db.cjs",
    "db:generate": "pnpm --filter @3cloud/api db:generate",
    "db:migrate": "pnpm --filter @3cloud/api db:migrate",
    "db:push": "pnpm --filter @3cloud/api db:push",
    "db:seed": "pnpm --filter @3cloud/api db:seed",
    "db:reset": "node api/reset-db.cjs",
    "test": "pnpm --filter @3cloud/api test",
    "lint": "pnpm --parallel -r lint",
    "verify": "node scripts/test-integration.cjs"
  }
}
