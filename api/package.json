    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "drizzle-orm": "^0.42.0",
    "postgres": "^3.4.7",
    "ioredis": "^5.6.1",
    "zod": "^3.24.4",
    "pino": "^9.7.0",
    "pino-pretty": "^13.1.2",
    "js-tiktoken": "^1.0.20",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.1.5",
    "ky": "^1.8.4",
    "dotenv": "^16.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "typescript": "^5.8.3",
